# FIRST Events API (primary data source). Register at https://ftc-events.firstinspires.org/api-docs/
FTC_EVENTS_USERNAME=""
FTC_EVENTS_TOKEN=""
# Email sign-in codes (Resend). Without a key, sign-in is hidden and personal data stays on the device.
RESEND_API_KEY=""
EMAIL_FROM="Control Scout <verify@tryctrlpoint.org>"
# Contact form (/contact): where messages are emailed, through Resend above. Every message is also
# stored in the database (contact_messages). Never sent to the browser. Unset: stored only.
CONTACT_TO=""
# Google sign-in (optional; dormant until both are set).
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Public URL of the app (links in emails, OAuth callbacks).
APP_URL="http://localhost:5173"
# Database: a local SQLite file by default; a libsql:// URL + token for Turso.
DATABASE_URL="file:.data/scout.db"
DATABASE_AUTH_TOKEN=""
PORT=3000
# Owner-only usage statistics: GET /api/stats/summary with "Authorization: Bearer <STATS_TOKEN>".
# Leave empty to switch the endpoint off (404). `npm run stats:report` on the server needs no token.
STATS_TOKEN=""
# In-app error reports → GitHub issues (docs/error-reporting.md). A fine-grained personal access token with
# Issues: read and write on Control-Point-FTC/control-scout only. Unset: reports are stored (error_reports), not filed.
GITHUB_REPORT_TOKEN=""
# Owners (comma-separated emails): the signed-in accounts allowed to read owner-only data,
# e.g. GET /api/reports/errors and the owner portal (/owner, /api/owner/*). Everyone else gets a 404. Empty: no one.
OWNER_EMAILS=""
