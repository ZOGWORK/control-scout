# FIRST Events API (primary data source). Register at https://ftc-events.firstinspires.org/api-docs/
FTC_EVENTS_USERNAME=""
FTC_EVENTS_TOKEN=""
# Email sign-in codes (Resend). Without a key, sign-in is hidden and personal data stays on the device.
RESEND_API_KEY=""
EMAIL_FROM="Control Scout <verify@tryctrlpoint.org>"
# Contact form (/contact): where messages are emailed, through Resend above. Every message is also
# stored in the database (contact_messages). Never sent to the browser. Unset: stored only.
CONTACT_TO=""
# Google sign-in (optional; dormant until both are set).
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Public URL of the app (links in emails, OAuth callbacks).
APP_URL="http://localhost:5173"
# Database: a local SQLite file by default; a libsql:// URL + token for Turso.
DATABASE_URL="file:.data/scout.db"
DATABASE_AUTH_TOKEN=""
PORT=3000
# Owner-only usage statistics: GET /api/stats/summary with "Authorization: Bearer <STATS_TOKEN>".
# Leave empty to switch the endpoint off (404). `npm run stats:report` on the server needs no token.
STATS_TOKEN=""
# In-app error reports → GitHub issues (docs/error-reporting.md). A fine-grained personal access token with
# Issues: read and write on Control-Point-FTC/control-scout only. Unset: reports are stored (error_reports), not filed.
GITHUB_REPORT_TOKEN=""
# Owners (comma-separated emails): the signed-in accounts allowed to read owner-only data,
# e.g. GET /api/reports/errors and the owner portal (/owner, /api/owner/*). Everyone else gets a 404. Empty: no one.
OWNER_EMAILS=""
# Entry photos in Cloudflare R2 (docs/r2-photos.md). Key id, secret, bucket and endpoint (or account id) all set:
# workspace members can attach photos to scout entries. Unset: photos are off and hidden. Never sent to the browser
# or logged. R2_PUBLIC_URL isn't needed: the bucket stays private and photos are shown through short-lived signed URLs.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""
R2_ENDPOINT=""
R2_PUBLIC_URL=""
# New photo uploads stop at this many GB stored (10^9 bytes), under R2's 10 GB free tier. Empty: 9.5.
R2_SOFT_CAP_GB=""
# Web push (docs/push.md): match reminders, upsets and event starts for signed-in devices that opt in. Generate the pair
# once with `npx web-push generate-vapid-keys` and keep it: changing it silently ends every existing subscription. Every
# server (the VM and any backup host) uses the same pair. VAPID_SUBJECT is a contact for push services: mailto: or https:.
# All three unset: push is unavailable and Settings says so. The private key is never sent to the browser or logged.
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT=""
# Development only (ignored in production): R2_FAKE=1 uses a local stand-in for the bucket; R2_FAKE_DIR keeps its
# objects on disk instead of in memory.
# R2_FAKE=1
# R2_FAKE_DIR=".data/fake-r2"
