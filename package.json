{
  "name": "control-scout",
  "private": true,
  "version": "1.15.0",
  "description": "FTC Control Scout — free FTC scouting and prediction for every team.",
  "license": "GPL-3.0-only",
  "type": "module",
  "workspaces": [
    "packages/*",
    "bot"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "postinstall": "npm run build -w @control-scout/predict-engine",
    "dev": "concurrently -k -n api,web -c yellow,cyan \"tsx watch server/index.ts\" \"vite\"",
    "dev:api": "tsx watch server/index.ts",
    "dev:web": "vite",
    "bot": "tsx bot/index.ts",
    "build": "npm run build -w @control-scout/predict-engine && vite build",
    "start": "NODE_ENV=production tsx server/index.ts",
    "lint": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "sync": "tsx scripts/sync.ts",
    "seed:scout": "tsx scripts/seed-from-scout-cache.ts",
    "stats": "tsx scripts/stats.ts",
    "stats:report": "tsx scripts/stats-report.ts",
    "packs": "tsx scripts/build-packs.ts",
    "db:export": "tsx scripts/db-export.ts",
    "db:push": "tsx scripts/db-push.ts",
    "snapshot": "tsx scripts/snapshot.ts",
    "replica:check": "tsx scripts/replica-check.ts",
    "live:check": "tsx scripts/live-check.ts",
    "equivalence": "tsx scripts/engine-equivalence.ts",
    "shots": "tsx scripts/shots.ts",
    "audit": "tsx scripts/audit.ts",
    "audit:flows": "tsx scripts/audit-flows.ts",
    "a11y": "tsx scripts/a11y.ts",
    "perf": "tsx scripts/perf.ts",
    "query-profile": "tsx scripts/query-profile.ts",
    "power-rankings:new": "tsx scripts/power-rankings-new.ts",
    "power-rankings:check": "tsx scripts/power-rankings-check.ts",
    "audit:perf": "npm run build && tsx scripts/perf.ts --budgets"
  },
  "dependencies": {
    "@control-scout/predict-engine": "*",
    "@libsql/client": "^0.18.0",
    "@resvg/resvg-wasm": "2.6.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "compression": "^1.8.1",
    "d3-geo": "^3.1.1",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "marked": "^18.1.1",
    "motion": "^12.23.24",
    "radix-ui": "^1.7.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.18.4",
    "recharts": "^3.7.0",
    "sonner": "^2.0.8",
    "sql.js": "1.14.2",
    "tailwind-merge": "^3.5.0",
    "topojson-client": "^3.1.0",
    "tsx": "^4.20.6",
    "tw-animate-css": "^1.4.0",
    "uqr": "0.1.3",
    "web-push": "^3.6.7",
    "world-atlas": "^2.0.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@tailwindcss/vite": "^4.1.14",
    "@testing-library/react": "^16.3.3",
    "@types/compression": "^1.8.1",
    "@types/d3-geo": "^3.1.0",
    "@types/express": "^4.17.23",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/topojson-client": "^3.1.5",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "^5.0.4",
    "concurrently": "^9.2.1",
    "fake-indexeddb": "^6.2.4",
    "jsdom": "^30.1.1",
    "playwright": "^1.56.1",
    "tailwindcss": "^4.1.14",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "vitest": "^5.0.2"
  }
}
